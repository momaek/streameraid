erDiagram
    USER ||--o{ POST : writes
    USER ||--o{ COMMENT : writes
    POST ||--o{ COMMENT : has
    POST }o--o{ TAG : tagged

    USER {
        int id PK
        string username
        string email
        datetime created_at
    }
    POST {
        int id PK
        int author_id FK
        string title
        text body
        datetime published_at
    }
    COMMENT {
        int id PK
        int post_id FK
        int user_id FK
        text content
    }
    TAG {
        int id PK
        string name
    }
